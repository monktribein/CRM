# ---- Required ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# MongoDB 5.0+ (MongoDB Atlas recommended). Never commit real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (overrides any name in the URI). Default: bizwoke_nova
MONGODB_DB_NAME=bizwoke_nova
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-32-chars
# Comma-separated allowed frontend origins; the first is used in email links.
# Production values must use https://
FRONTEND_URL=http://localhost:3000
APP_NAME=Bizwoke Nova

# ---- Optional ----------------------------------------------------------------
# Only needed if frontend and API share a parent domain (e.g. .example.com).
# COOKIE_DOMAIN=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# AUTH_RATE_LIMIT=10
# MONGODB_MAX_POOL_SIZE=20
# Build indexes automatically at startup (default true). Set false and run `npm run db:indexes` on deploy instead.
# MONGODB_AUTO_INDEX=true
# LOG_LEVEL=info

# Swagger is on outside production at /api/v1/docs. In production it is off
# unless enabled, and then always behind HTTP basic auth.
# SWAGGER_ENABLED=false
# SWAGGER_USER=
# SWAGGER_PASSWORD=

# Email (invitations, password resets, notification emails). Without SMTP the
# API returns one-time invitation links to admins and password-reset emails
# cannot be delivered.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.com

# ---- First Super Admin: npm run db:bootstrap (safe in production) ------------
# SEED_ADMIN_EMAIL=owner@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# SEED_ORG_NAME=
# SEED_ORG_SLUG=

# ---- Synthetic demo data: npm run db:seed (refuses to run in production) -----
# SEED_DEV_PASSWORD=
